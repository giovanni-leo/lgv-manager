# Copy to .env and fill in. Never commit .env.
DOMAIN=localhost
# Ports on this machine (change only if 80/443 are already in use, e.g. on Umbrel)
# HTTP_PORT=80
# HTTPS_PORT=443
# Name of the app in the top bar and in authenticator apps (not a fund)
APP_NAME=VC Manager
# Optional: open "Manual" from an external page instead of the built-in one
# USER_MANUAL_URL=

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost
REQUIRE_2FA=1
DOCUMENT_MAX_UPLOAD_MB=100

POSTGRES_DB=vc
POSTGRES_USER=vc
POSTGRES_PASSWORD=change-me

# Claude: web research and email analysis (leave empty to turn off)
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_READ_ATTACHMENTS=1

# Intake mailbox read by the worker (IMAP with password; Gmail: imap.gmail.com + an app password)
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_USER=
MAIL_IMAP_PASSWORD=
MAIL_IMAP_FOLDER=INBOX
# Only these senders are processed: addresses or whole domains, comma separated
MAIL_ALLOWED_SENDERS=@lakegrowth.example
# Server whose DMARC/DKIM/SPF verdict proves the sender (automatic for Gmail: mx.google.com)
# MAIL_AUTH_SERVER=

# Nightly encrypted backup (set up with: sh docker/backup-setup.sh)
# COMPOSE_PROFILES=backup
# BACKUP_AGE_RECIPIENT=age1...          public key only; the secret key stays with a person
# BACKUP_ALERT_EMAIL=                   who is told when a backup fails
# BACKUP_TIME=02:30
# BACKUP_REMOTE=gdrive:LGV-Backups
